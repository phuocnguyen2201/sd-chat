# /etc/systemd/system/jwks-refresh.timer
# Refreshes the JWKS cache every 12h while Supabase is reachable, so JWT
# verification at request time never needs to call Supabase live.

[Unit]
Description=Refresh cached Supabase JWKS every 12h

[Timer]
OnBootSec=5min
OnUnitActiveSec=12h
Persistent=true

[Install]
WantedBy=timers.target
